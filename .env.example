# https://my.telegram.org → "API development tools" bo'limidan olinadi
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# @BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:AAAbbbCCCdddEEEfffGGG

# Botdan foydalana oladiganlar ID raqamlari (vergul bilan).
# Bo'sh qoldirilsa, botdan hamma foydalana oladi. ID ni bilish uchun botga /start yozing.
ALLOWED_USERS=

# Nechta reels va har biri taxminan necha soniya bo'lsin
CLIP_COUNT=10
CLIP_LEN=40

# Kadrni kattalashtirish: 1.0 = kadr to'liq, 1.3 = kattaroq (yon tomonlari biroz kesiladi)
# 1.3 = yon tomonlari biroz kesiladi, kino telefonda kattaroq ko'rinadi
KADR_ZOOM=1.3

# ---- Tarif va to'lov ----
# Adminlar (vergul bilan): to'lovlarni tasdiqlaydi, /grant va /stats ishlatadi
ADMIN_IDS=
# To'lov qabul qilinadigan karta (Uzcard/Humo) va egasi
CARD_NUMBER=
CARD_HOLDER=
# Narxlar (so'm) va tarif muddati (kun)
PRICE_START=29000
PRICE_PRO=59000
PLAN_DAYS=30
# Bepul tarifda kuniga nechta kino
DAILY_LIMIT=1

# Bir vaqtda nechta kino ishlansin (1–10). Server kuchiga qarab: 4 GB / 2 yadro uchun 2 tavsiya etiladi.
WORKERS=1
# Navbatda eng ko'pi bilan nechta kino kutsin
QUEUE_MAX=5
